# === REQUIRED ===

# Get a free Groq API key: https://console.groq.com/keys
# Groq is free (no credit card) and OpenAI-compatible.
OPENAI_API_KEY=gsk_your_groq_api_key_here

# === Optional overrides ===

# API base URL (change to use OpenAI, Together, DeepSeek, etc.)
#   Groq:     https://api.groq.com/openai/v1   (default)
#   OpenAI:   https://api.openai.com/v1
#   Together: https://api.together.xyz/v1
#   DeepSeek: https://api.deepseek.com/v1
OPENAI_BASE_URL=https://api.groq.com/openai/v1

# Model to use (default: llama-3.3-70b-versatile)
# Available Groq models: https://console.groq.com/docs/models
OPENAI_MODEL=llama-3.3-70b-versatile
